{# Theme "events": yellow title band, grey filter bar (search pill + tag chips), grid of event cards. Keeps the ids/data-attributes site.js filters on. #}
{% import "themes/events/cards.njk" as ev with context %}

<section class="pg-band" aria-labelledby="pg-t">
  <div class="in">
    <p class="crumbs"><a href="{{ url('home') }}">{{ settings.site_title }}</a><span aria-hidden="true">/</span><b>{{ t('archive.h') }}</b></p>
    <div class="band-row">
      <h1 id="pg-t" class="page-title">{{ t('archive.h') }}</h1>
      <p class="band-note">{{ t('archive.count', {n: totalCount}) }}{% if listeners %} · {{ t('issue.listeners', {n: listeners}) }}{% endif %}</p>
    </div>
  </div>
</section>

<div class="tools">
  <form method="get" action="{{ url('archive') }}" role="search">
    {% if tag %}<input type="hidden" name="tag" value="{{ tag }}">{% endif %}
    {{ ev.search_icon() }}
    <input type="search" name="q" id="arch-q" value="{{ q }}" placeholder="{{ t('archive.search') }}" aria-label="{{ t('archive.search') }}" autocomplete="off">
  </form>
  <div class="chips" role="group" aria-label="Tags" id="arch-tags">
    <a class="chip" href="{{ url('archive') }}" data-tag="" {% if not tag %}aria-current="true"{% endif %}>{{ t('archive.all') }}</a>
    {% for tg in tags %}<a class="chip" href="{{ url('archive') }}?tag={{ tg | urlencode }}" data-tag="{{ tg }}" {% if tag == tg %}aria-current="true"{% endif %}>{{ tagName(tagFull.get(tg)) }}</a>{% endfor %}
  </div>
</div>

{% if issues | length %}
<div class="ev-grid cards" id="arch-list">
  {% for i in issues %}
    <div data-slug="{{ i.slug }}" data-tags="{% for tg in i.tags %}{{ tagKey(tg) }}{{ '|' if not loop.last }}{% endfor %}" style="display:contents">{{ ev.card(i) }}</div>
  {% endfor %}
</div>
<p class="empty" id="arch-none" hidden>{{ t('archive.none') }}</p>
{% else %}
<p class="empty" id="arch-none">{{ t('archive.none') }}</p>
{% endif %}
