{# Theme "events": yellow title band, then event rows with a yellow date block (months as headings). #}
{% macro rows(list) %}
  {% set curMonth = '' %}
  {% set months = (['янв','фев','мар','апр','мая','июн','июл','авг','сен','окт','ноя','дек'] if lang == 'ru' else ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']) %}
  {% for i in list %}
    {% set mk = dMonthKey(i.start_at) %}
    {% if mk != curMonth %}
      {% if curMonth %}</div>{% endif %}
      <div class="sched-month"><h3>{{ fx.dmonth(i.start_at) }}</h3>
      {% set curMonth = mk %}
    {% endif %}
    {% set st = statusOf(i) %}
    {% set dd = dShort(i.start_at).split('.') %}
    {% set href = url('issue', {slug: i.slug}) %}
    <article class="ev-row{{ ' is-past' if st == 'past' }}{{ ' is-cancelled' if st == 'cancelled' }}">
      <a class="date" href="{{ href }}" tabindex="-1" aria-hidden="true"><b>{{ dd[0] | int }}</b><span>{{ months[(dd[1] | int) - 1] }}</span><small>{{ fx.dwd(i.start_at) }} · {{ dTime(i.start_at) }}</small></a>
      <div class="rbody">
        <span class="flag {{ st }}">{{ t('status.' + st) }}</span>
        <h3><a href="{{ href }}">{{ L(i, 'title') }}</a></h3>
        <p class="meta">{{ i.lecturers | map_names(lang) }}{% if L(i, 'place') %} · {{ L(i, 'place') }}{% endif %}</p>
      </div>
      <div class="act">
        {% if st == 'past' %}<a class="btn primary" href="{{ href }}">{{ 'Читать' if lang == 'ru' else 'Read' }}</a>
        {% elif st == 'reg_open' %}<a class="btn primary" href="{{ i.reg_url }}" target="_blank" rel="noopener" data-goal="register">{{ t('btn.register') }}</a>
        {% else %}<a class="btn" href="{{ href }}">{{ t('btn.details') }}</a>{% endif %}
      </div>
    </article>
  {% endfor %}
  {% if curMonth %}</div>{% endif %}
{% endmacro %}

<section class="pg-band" aria-labelledby="pg-t">
  <div class="in">
    <p class="crumbs"><a href="{{ url('home') }}">{{ settings.site_title }}</a><span aria-hidden="true">/</span><b>{{ t('sched.h') }}</b></p>
    <div class="band-row">
      <h1 id="pg-t" class="page-title">{{ t('sched.h') }}</h1>
      <p class="band-note">{{ t('sched.tz') }}</p>
    </div>
  </div>
</section>

<div class="sub-bar">
  <a class="btn" href="{{ webcal }}" data-goal="calendar-feed">{{ t('btn.subscribe') }}</a>
  <span class="hint">Google, Apple, Yandex · <a href="/raspisanie.ics">.ics</a></span>
</div>

{% if upcoming | length %}
  {{ rows(upcoming) }}
{% else %}
  <p class="empty">{{ t('sched.empty') }}</p>
{% endif %}

{% if past | length %}
<details class="past-box" id="past-box">
  <summary data-closed="{{ t('btn.show_past', {n: past | length}) }}" data-open="{{ t('btn.hide_past') }}">{{ t('btn.show_past', {n: past | length}) }}</summary>
  {{ rows(past) }}
</details>
{% endif %}
