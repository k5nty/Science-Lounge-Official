{# Theme "events": white header, boxed monogram + two-line wordmark, bold nav with a yellow active underline, pill on the right. Phone: logo, search, hamburger (<details>, no JS). #}
{% set sw = langSwitch() %}
{% set items = navItems() %}
{% set tagline = (settings.site_tagline_en or t('brand.tagline')) if lang == 'en' else (settings.site_tagline or t('brand.tagline')) %}
<header class="mast">
  <div class="mast-in">
    <a class="brand" href="{{ url('home') }}">
      <span class="sq" aria-hidden="true">SL</span>
      <span class="wm"><b>{{ settings.site_title }}</b><span>{{ tagline }}</span></span>
    </a>
    <nav class="main" aria-label="{{ t('nav.menu') }}">
      {% for n in items %}{% if n.key != 'schedule' %}<a href="{{ n.href }}"{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a>{% endif %}{% endfor %}
    </nav>
    <div class="mast-tools">
      <a class="m-search" href="{{ url('archive') }}" aria-label="{{ t('archive.search') }}" title="{{ t('archive.search') }}"><svg viewBox="0 0 28 28" aria-hidden="true"><circle cx="12" cy="12" r="8.2" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M18.2 18.2 25 25" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></a>
      <a class="lang" href="{{ sw.href }}" hreflang="{{ sw.hreflang }}" lang="{{ sw.hreflang }}" title="{{ sw.title }}">{{ sw.label }}</a>
      {% for n in items %}{% if n.key == 'schedule' %}<a class="btn primary mast-pill" href="{{ n.href }}"{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a>{% endif %}{% endfor %}
      <details class="m-menu">
        <summary aria-label="{{ t('nav.menu') }}">
          <svg class="ic-open" viewBox="0 0 28 28" aria-hidden="true"><path d="M2 6h24M2 14h24M2 22h24" fill="none" stroke="currentColor" stroke-width="3"/></svg>
          <svg class="ic-close" viewBox="0 0 28 28" aria-hidden="true"><path d="M5 5l18 18M23 5 5 23" fill="none" stroke="currentColor" stroke-width="3"/></svg>
        </summary>
        <div class="m-panel">
          <nav aria-label="{{ t('nav.menu') }}">
            {% for n in items %}<a href="{{ n.href }}"{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a>{% endfor %}
          </nav>
          <div class="m-row">
            <a class="btn" href="{{ sw.href }}" hreflang="{{ sw.hreflang }}" lang="{{ sw.hreflang }}">{{ sw.title }}</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
