{# Campus footer: deep navy, brand + three short link columns, one thin base line. #}
{% set tagline = (settings.site_tagline_en or t('brand.tagline')) if lang == 'en' else (settings.site_tagline or t('brand.tagline')) %}
<footer class="site cm-foot">
  <div class="wrap cm-foot-grid">
    <div class="cm-foot-brand">
      <a class="cm-brand" href="{{ url('home') }}">
        <svg class="cm-crest" viewBox="0 0 40 46" width="40" height="46" aria-hidden="true" focusable="false"><path class="cm-crest-bg" d="M1 1h38v27c0 9-9 14-19 17C10 42 1 37 1 28Z"/><path class="cm-crest-ln" d="M4.5 4.5h31v23.2c0 6.6-7.2 10.6-15.5 13.3C11.7 38.3 4.5 34.3 4.5 27.7Z" fill="none"/><text class="cm-crest-tx" x="20" y="26" text-anchor="middle">SL</text></svg>
        <span class="cm-brand-text"><b>{{ settings.site_title }}</b><small>{{ tagline }}</small></span>
      </a>
    </div>
    <nav aria-labelledby="cm-f1">
      <h2 id="cm-f1" class="cm-foot-h">{{ t('footer.sections') }}</h2>
      <ul>{% for n in navItems() %}<li><a href="{{ n.href }}">{{ n.label }}</a></li>{% endfor %}</ul>
    </nav>
    <div>
      <h2 class="cm-foot-h">{{ t('footer.contact') }}</h2>
      <ul>
        {% if channelUrl %}<li><a href="{{ channelUrl }}" target="_blank" rel="noopener" data-goal="channel">Telegram</a></li>{% endif %}
        {% if settings.contact_email %}<li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>{% endif %}
        <li><a href="{{ url('feedback') }}?t=contact">{{ t('fb.contact') }}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="cm-foot-h">{{ t('footer.legal') }}</h2>
      <ul>
        <li><a href="/politika">{{ t('footer.policy') }}</a></li>
        <li><a href="/udalit-foto">{{ t('photo.h') }}</a></li>
        <li><a href="/feed.xml">{{ t('footer.rss') }}</a></li>
        <li><a href="/raspisanie.ics">{{ t('footer.cal') }}</a></li>
      </ul>
    </div>
  </div>
  <div class="cm-foot-base"><div class="wrap"><span>{{ settings.site_title }}</span><span>{{ t('footer.made_by') }}</span></div></div>
</footer>
