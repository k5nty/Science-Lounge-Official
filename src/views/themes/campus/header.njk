{# Campus header: thin utility strip (navy) + main bar with crest, plain-text nav and, on phones, a "Menu" disclosure. #}
{% set sw = langSwitch() %}
{% set items = navItems() %}
{% set tagline = (settings.site_tagline_en or t('brand.tagline')) if lang == 'en' else (settings.site_tagline or t('brand.tagline')) %}
{% set menuWord = 'Меню' if lang == 'ru' else 'Menu' %}
{% set findWord = 'Поиск' if lang == 'ru' else 'Search' %}
<header class="mast cm-mast">
  <div class="cm-strip">
    <div class="cm-in">
      <ul class="cm-util">
        {% if channelUrl %}<li><a href="{{ channelUrl }}" target="_blank" rel="noopener" data-goal="channel">{{ t('nav.channel') }}</a></li>{% endif %}
        <li><a href="{{ sw.href }}" hreflang="{{ sw.hreflang }}" lang="{{ sw.hreflang }}" title="{{ sw.title }}">{{ sw.label }}</a></li>
      </ul>
      <div class="cm-strip-end">
        {% for n in items %}{% if n.cta %}<a class="cm-support" href="{{ n.href }}"{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a>{% endif %}{% endfor %}
        <form class="cm-search" role="search" method="get" action="{{ url('archive') }}">
          <label class="visually-hidden" for="cm-q">{{ t('archive.search') }}</label>
          <input type="search" id="cm-q" name="q" value="{{ q }}" placeholder="{{ findWord }}" autocomplete="off">
          <button type="submit" aria-label="{{ findWord }}"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false"><path d="M8.5 2.5a6 6 0 1 0 3.6 10.8l4.3 4.3 1.2-1.2-4.3-4.3A6 6 0 0 0 8.5 2.5Zm0 1.7a4.3 4.3 0 1 1 0 8.6 4.3 4.3 0 0 1 0-8.6Z" fill="currentColor"/></svg></button>
        </form>
      </div>
    </div>
  </div>
  <div class="cm-bar">
    <div class="cm-in">
      <a class="brand cm-brand" href="{{ url('home') }}">
        <svg class="cm-crest" viewBox="0 0 40 46" width="40" height="46" aria-hidden="true" focusable="false"><path class="cm-crest-bg" d="M1 1h38v27c0 9-9 14-19 17C10 42 1 37 1 28Z"/><path class="cm-crest-ln" d="M4.5 4.5h31v23.2c0 6.6-7.2 10.6-15.5 13.3C11.7 38.3 4.5 34.3 4.5 27.7Z" fill="none"/><text class="cm-crest-tx" x="20" y="26" text-anchor="middle">SL</text></svg>
        <span class="cm-brand-text"><b>Science Lounge</b><small>{{ tagline }}</small></span>
      </a>
      <nav class="main cm-nav" aria-label="{{ t('nav.menu') }}">
        {% for n in items %}{% if not n.cta %}<a href="{{ n.href }}"{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a>{% endif %}{% endfor %}
      </nav>
      <details class="cm-menu">
        <summary><span>{{ menuWord }}</span></summary>
        <div class="cm-panel">
          <nav aria-label="{{ t('nav.menu') }}">
            {% for n in items %}<a href="{{ n.href }}"{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a>{% endfor %}
          </nav>
          <form class="cm-search" role="search" method="get" action="{{ url('archive') }}">
            <label class="visually-hidden" for="cm-q2">{{ t('archive.search') }}</label>
            <input type="search" id="cm-q2" name="q" value="{{ q }}" placeholder="{{ findWord }}" autocomplete="off">
            <button type="submit" aria-label="{{ findWord }}"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false"><path d="M8.5 2.5a6 6 0 1 0 3.6 10.8l4.3 4.3 1.2-1.2-4.3-4.3A6 6 0 0 0 8.5 2.5Zm0 1.7a4.3 4.3 0 1 1 0 8.6 4.3 4.3 0 0 1 0-8.6Z" fill="currentColor"/></svg></button>
          </form>
          <p class="cm-panel-links">
            {% if channelUrl %}<a href="{{ channelUrl }}" target="_blank" rel="noopener" data-goal="channel">{{ t('nav.channel') }}</a>{% endif %}
            <a href="{{ sw.href }}" hreflang="{{ sw.hreflang }}" lang="{{ sw.hreflang }}" title="{{ sw.title }}">{{ sw.label }}</a>
          </p>
        </div>
      </details>
    </div>
  </div>
</header>
