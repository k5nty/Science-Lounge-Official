{# press: navy bar. Wordmark | divider | sections, outline icons on the right; on phones the sections sit behind a menu icon (<details>, works without JS). #}
{% set sw = langSwitch() %}
{% set words = (settings.site_title or 'Science Lounge').split(' ') %}
<header class="mast pr-mast" id="mast">
  <div class="wrap">
    <a class="brand" href="{{ url('home') }}" aria-label="{{ settings.site_title }}"><b>{{ words[0] }}</b>{% if words.length > 1 %}<i>{{ words.slice(1).join(' ') }}</i>{% endif %}</a>
    <nav class="main pr-nav" aria-label="{{ t('nav.menu') }}">
      {% for n in navItems() %}<a href="{{ n.href }}"{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a>{% endfor %}
    </nav>
    <div class="mast-tools pr-tools">
      {% if channelUrl %}<a class="pr-ico pr-ico-chan" href="{{ channelUrl }}" target="_blank" rel="noopener" data-goal="channel" aria-label="{{ t('nav.channel') }}" title="{{ t('nav.channel') }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.5 3.5 2.8 10.7l5.7 2.2 2.2 6.4 3.2-3.8 4.9 3.6z"/><path d="M8.5 12.9 21.5 3.5"/></svg></a>{% endif %}
      <a class="pr-ico" href="{{ url('archive') }}#search" aria-label="{{ t('archive.search') }}" title="{{ t('archive.search') }}"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5.5 5.5"/></svg></a>
      <a class="lang" href="{{ sw.href }}" hreflang="{{ sw.hreflang }}" lang="{{ sw.hreflang }}" title="{{ sw.title }}">{{ sw.label }}</a>
      <details class="pr-menu">
        <summary aria-label="{{ t('nav.menu') }}">
          <svg class="i-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="i-close" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
        </summary>
        <div class="pr-panel">
          <nav aria-label="{{ t('nav.menu') }}">
            {% for n in navItems() %}<a href="{{ n.href }}"{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a>{% endfor %}
          </nav>
          <div class="pr-panel-foot">
            {% if channelUrl %}<a href="{{ channelUrl }}" target="_blank" rel="noopener" data-goal="channel">{{ t('nav.channel') }}</a>{% endif %}
            <a href="{{ sw.href }}" hreflang="{{ sw.hreflang }}" lang="{{ sw.hreflang }}">{{ sw.label }}</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
