{# press: short navy footer. Wordmark and sections on top, a hairline, then small print links. #}
{% set words = (settings.site_title or 'Science Lounge').split(' ') %}
<footer class="site pr-foot">
  <div class="wrap pr-foot-top">
    <a class="brand" href="{{ url('home') }}"><b>{{ words[0] }}</b>{% if words.length > 1 %}<i>{{ words.slice(1).join(' ') }}</i>{% endif %}</a>
    <nav aria-label="{{ t('footer.sections') }}">
      {% for n in navItems() %}<a href="{{ n.href }}">{{ n.label }}</a>{% endfor %}
      {% if channelUrl %}<a href="{{ channelUrl }}" target="_blank" rel="noopener" data-goal="channel">Telegram</a>{% endif %}
    </nav>
  </div>
  <div class="wrap"><hr class="pr-foot-rule"></div>
  <div class="wrap pr-foot-bottom">
    <span>{{ t('footer.made_by') }}</span>
    <ul>
      {% if settings.contact_email %}<li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>{% endif %}
      <li><a href="/politika">{{ t('footer.policy') }}</a></li>
      <li><a href="/udalit-foto">{{ t('photo.h') }}</a></li>
      <li><a href="/feed.xml">{{ t('footer.rss') }}</a></li>
      <li><a href="/raspisanie.ics">{{ t('footer.cal') }}</a></li>
    </ul>
  </div>
</footer>
