{# plain home: Upcoming as hairline rows (date, round portrait, NAME, title), Past as a two-column grid, one-line suggest form. #}
{% import "partials/macros.njk" as m with context %}
{% import "partials/forms.njk" as f with context %}

{% macro dateBlock(iso) %}
  {%- set mons = ['янв','фев','мар','апр','мая','июн','июл','авг','сен','окт','ноя','дек'] if lang == 'ru' else ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'] -%}
  {%- set p = dShort(iso).split('.') -%}
  <span class="pl-date"><span class="pl-mon">{{ mons[(p[1] | int) - 1] }}</span><span class="pl-day">{{ p[0] | int }}</span></span>
{% endmacro %}

{% macro upRow(i, isLead) %}
  <li class="pl-row{{ ' pl-lead' if isLead }}{{ ' is-cancelled' if isLead and leadStatus == 'cancelled' }}">
    {{ dateBlock(i.start_at) }}
    <span class="pl-ph">{% if i.lecturer %}{{ m.portrait(i.lecturer, {sizes: '96px', src: 480, eager: isLead}) }}{% endif %}</span>
    <div class="pl-txt">
      <a class="pl-link" href="{{ url('issue', {slug: i.slug}) }}"><span class="pl-name">{{ i.lecturers | map_names(lang) }}</span><span class="pl-title">{{ L(i, 'title') }}</span></a>
      {% if isLead %}
        <p class="pl-meta">{{ fx.dwd(i.start_at) }}, {{ dTime(i.start_at) }}{% if L(i, 'place') %} · {{ L(i, 'place') }}{% endif %}</p>
        {% if leadStatus == 'cancelled' or leadStatus == 'moved' or leadStatus == 'sold_out' %}<p class="pl-meta">{{ m.statusLabel(leadStatus) }}</p>{% endif %}
        {% if leadHtml %}<div class="pl-text">{{ leadHtml | safe }}</div>{% endif %}
        <p class="pl-acts">
          <a href="/vypusk/{{ i.slug }}.ics" data-goal="calendar">{{ t('btn.calendar') }} →</a>
          {% if i.reg_enabled and i.reg_url and leadStatus != 'sold_out' and leadStatus != 'cancelled' %}<a href="{{ i.reg_url }}" target="_blank" rel="noopener" data-goal="register">{{ t('btn.register') }} →</a>{% endif %}
        </p>
      {% endif %}
    </div>
  </li>
{% endmacro %}

<h1 class="visually-hidden">{{ settings.site_title }}</h1>

{% if isNext or (upcomingList | length) %}
<section class="pl-sec">
  <div class="sec-head"><h2>{{ 'Ближайшие' if lang == 'ru' else 'Upcoming' }}</h2><a href="{{ url('schedule') }}">{{ t('nav.schedule') }} →</a></div>
  {% if isNext %}<ul class="pl-list pl-one">{{ upRow(lead, true) }}</ul>{% endif %}
  <ul class="pl-list">{% for i in upcomingList %}{% if not (isNext and i.id == lead.id) %}{{ upRow(i, false) }}{% endif %}{% endfor %}</ul>
</section>
{% endif %}

{% if latest | length %}
<section class="pl-sec">
  <div class="sec-head"><h2>{{ 'Прошедшие' if lang == 'ru' else 'Past' }}</h2><a href="{{ url('archive') }}">{{ t('btn.all_issues') }} →</a></div>
  <div class="cards">{% for i in latest %}{{ m.issueCard(i) }}{% endfor %}</div>
</section>
{% endif %}

{% if not isNext and not (latest | length) %}<p class="empty">{{ t('home.empty_h') }}</p>{% endif %}

<section class="pl-sec pl-suggest">
  <div class="sec-head"><h2>{{ t('home.suggest_h') }}</h2></div>
  {{ f.suggestInline() }}
</section>
