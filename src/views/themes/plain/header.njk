{# plain: centered wordmark, navigation split left and right of it (Long Now pattern). Phone: wordmark + <details> menu, works without JS. #}
{% set sw = langSwitch() %}
{% set items = navItems() %}
{% set tag = (settings.site_tagline_en or t('brand.tagline')) if lang == 'en' else (settings.site_tagline or t('brand.tagline')) %}
<header class="pl-head">
  <div class="pl-bar">
    <nav class="pl-nav" aria-label="{{ t('nav.menu') }}">
      <ul class="pl-nav-l">
        {% for n in items %}{% if loop.index <= 3 %}<li><a href="{{ n.href }}"{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a></li>{% endif %}{% endfor %}
      </ul>
      <a class="pl-brand" href="{{ url('home') }}"><span class="pl-wm">{{ settings.site_title }}</span><span class="pl-sub">{{ tag }}</span></a>
      <ul class="pl-nav-r">
        {% for n in items %}{% if loop.index > 3 %}
          {% if n.cta %}<li><a class="pl-lang" href="{{ sw.href }}" hreflang="{{ sw.hreflang }}" lang="{{ sw.hreflang }}" title="{{ sw.title }}">{{ sw.label }}</a></li>{% endif %}
          <li><a href="{{ n.href }}"{% if n.cta %} class="cta"{% endif %}{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
    <details class="pl-menu">
      <summary aria-label="{{ t('nav.menu') }}"><svg viewBox="0 0 28 14" width="28" height="14" aria-hidden="true"><path d="M0 1.5h28M0 12.5h28" fill="none" stroke="currentColor" stroke-width="2"/></svg></summary>
      <ul>
        {% for n in items %}<li><a href="{{ n.href }}"{% if n.cta %} class="cta"{% endif %}{% if n.active %} aria-current="page"{% endif %}>{{ n.label }}</a></li>{% endfor %}
      </ul>
    </details>
    <a class="pl-lang pl-lang-m" href="{{ sw.href }}" hreflang="{{ sw.hreflang }}" lang="{{ sw.hreflang }}" title="{{ sw.title }}">{{ sw.label }}</a>
  </div>
</header>
