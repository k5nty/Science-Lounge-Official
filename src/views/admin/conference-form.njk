{% extends "layouts/admin.njk" %}
{% import "admin/_macros.njk" as a %}
{% block title %}Конференция {{ conf.year }}{% endblock %}

{% macro dayItem(d, i) %}
<div class="a-rep-item" data-item>
  <div class="a-rep-head"><b>День</b><span class="a-rep-tools"><button type="button" data-up>↑</button><button type="button" data-down>↓</button><button type="button" data-remove>×</button></span></div>
  <div class="a-two">
    <div class="a-field"><label>Название дня</label><input type="text" name="program[{{ i }}][title]" value="{{ d.title }}" maxlength="120" placeholder="День 1. Открытие"></div>
    <div class="a-field"><label>Дата</label><input type="text" name="program[{{ i }}][date]" value="{{ d.date }}" maxlength="40" placeholder="12 мая"></div>
  </div>
  <div class="a-field"><label>Расписание дня</label><textarea name="program[{{ i }}][items]" rows="5" placeholder="10:00 Открытие&#10;11:00 Постерная сессия">{{ d.itemsText }}</textarea><span class="a-hint">Каждая строка: время, пробел, название.</span></div>
</div>
{% endmacro %}

{% macro posterItem(p, i) %}
<div class="a-rep-item" data-item>
  <div class="a-rep-head"><b>Постер</b><span class="a-rep-tools"><button type="button" data-remove>×</button></span></div>
  {{ a.picker('Изображение постера', 'posters[' ~ i ~ '][media_id]', p.media, 'poster') }}
  <div class="a-two">
    <div class="a-field"><label>Название работы</label><input type="text" name="posters[{{ i }}][title]" value="{{ p.title }}" maxlength="200"></div>
    <div class="a-field"><label>Авторы</label><input type="text" name="posters[{{ i }}][authors]" value="{{ p.authors }}" maxlength="200"></div>
  </div>
</div>
{% endmacro %}

{% block content %}
<form method="post" action="{{ '/admin/conferences' if isNew else '/admin/conferences/' + conf.id }}" class="a-form" data-guard novalidate>
  <input type="hidden" name="_csrf" value="{{ csrf }}">
  <div class="a-head"><h1>{{ 'Новая конференция' if isNew else conf.title_ru ~ ', ' ~ conf.year }}</h1></div>
  {% if errors | length %}<div class="a-flash err"><ul>{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul></div>{% endif %}
  <div class="a-col">
    <section class="a-section"><h2>Основное</h2>
      <div class="a-grid">
        {{ a.field('Год', 'year', conf.year, {type: 'number', required: true}) }}
        {{ a.check('Показывать на сайте', 'published', conf.published) }}
      </div>
      <div class="a-grid">
        {{ a.field('Название', 'title_ru', conf.title_ru) }}
        {{ a.field('Название по-английски', 'title_en', conf.title_en) }}
      </div>
      <div class="a-grid">
        {{ a.field('Первый день', 'date_start', dateStart, {type: 'date'}) }}
        {{ a.field('Последний день', 'date_end', dateEnd, {type: 'date'}) }}
      </div>
      <div class="a-grid">
        {{ a.field('Место', 'place_ru', conf.place_ru) }}
        {{ a.field('Место по-английски', 'place_en', conf.place_en) }}
      </div>
      {{ a.field('О конференции', 'intro_ru', conf.intro_ru, {rows: 5, wide: true}) }}
      {{ a.field('О конференции по-английски', 'intro_en', conf.intro_en, {rows: 4, wide: true}) }}
    </section>

    <section class="a-section"><h2>Программа по дням</h2>
      <div data-repeater="program">
        <div data-list>{% for d in programView %}{{ dayItem(d, loop.index0) }}{% endfor %}</div>
        <template>{{ dayItem({}, '__i__') }}</template>
        <button type="button" class="a-btn" data-add>Добавить день</button>
      </div>
    </section>

    <section class="a-section"><h2>Жюри</h2>
      <p class="a-hint">Жюри берётся из списка лекторов. Сначала <a href="/admin/lecturers/new" target="_blank">добавьте человека как лектора</a>.</p>
      <div class="a-checks">{% for l in lecturers %}<label class="a-check small"><input type="checkbox" name="jury" value="{{ l.id }}" {% if l.id in juryIds %}checked{% endif %}><span>{{ l.name_ru }}</span></label>{% endfor %}</div>
    </section>

    <section class="a-section"><h2>Регионы-участники</h2>
      {{ a.field('Регионы', 'regions', regionsText, {rows: 6, wide: true, hint: 'Один регион на строке, как в списке субъектов РФ: «Москва», «Республика Татарстан»… Точки на карте России ставятся автоматически.'}) }}
    </section>

    <section class="a-section"><h2>Лучшие постеры</h2>
      <div data-repeater="posters">
        <div data-list>{% for p in posterView %}{{ posterItem(p, loop.index0) }}{% endfor %}</div>
        <template>{{ posterItem({}, '__i__') }}</template>
        <button type="button" class="a-btn" data-add>Добавить постер</button>
      </div>
    </section>

    <section class="a-section"><h2>Фото</h2>
      <div class="a-photos" data-photos data-purpose="photo">
        <div class="a-photo-bar">
          <label class="a-btn primary">Загрузить фото<input type="file" accept="image/*" multiple hidden></label>
          <select data-bulk-consent aria-label="Согласие для всех"><option value="">Согласие для всех фото…</option><option value="yes">да, согласие получено</option><option value="general">общий план, лиц не видно</option></select>
          <span class="a-status" data-status></span>
        </div>
        <ul class="a-photo-list" data-list>
          {% for p in photos %}
          <li class="a-photo" data-photo data-id="{{ p.id }}">
            <div class="a-photo-img"><img src="{{ p.thumb }}" alt=""></div>
            <div class="a-photo-fields">
              <input type="hidden" name="photos[]" value="{{ p.id }}">
              <div class="a-field"><label>Что на фото (alt, обязательно)</label><input type="text" name="photo_meta[m{{ p.id }}][alt]" value="{{ p.alt }}" maxlength="300"></div>
              <div class="a-two">
                <div class="a-field"><label>Автор снимка</label><input type="text" name="photo_meta[m{{ p.id }}][credit]" value="{{ p.credit }}" maxlength="150"></div>
                <div class="a-field"><label>Согласие</label><select name="photo_meta[m{{ p.id }}][consent]" data-consent>
                  <option value="pending" {% if p.consent == 'pending' %}selected{% endif %}>не проверено (не показывать)</option>
                  <option value="yes" {% if p.consent == 'yes' %}selected{% endif %}>да</option>
                  <option value="general" {% if p.consent == 'general' %}selected{% endif %}>общий план</option>
                  <option value="no" {% if p.consent == 'no' %}selected{% endif %}>нет</option></select></div>
              </div>
              <div class="a-photo-tools"><label class="a-check small"><input type="radio" name="cover_id" value="{{ p.id }}" {% if cover and cover.id == p.id %}checked{% endif %}><span>Обложка</span></label><button type="button" data-up>↑</button><button type="button" data-down>↓</button><button type="button" data-remove>Убрать</button></div>
            </div>
          </li>
          {% endfor %}
        </ul>
        <template>
          <li class="a-photo" data-photo data-id="__ID__">
            <div class="a-photo-img"><img src="__THUMB__" alt=""></div>
            <div class="a-photo-fields">
              <input type="hidden" name="photos[]" value="__ID__">
              <div class="a-field"><label>Что на фото (alt, обязательно)</label><input type="text" name="photo_meta[m__ID__][alt]" maxlength="300"></div>
              <div class="a-two">
                <div class="a-field"><label>Автор снимка</label><input type="text" name="photo_meta[m__ID__][credit]" maxlength="150"></div>
                <div class="a-field"><label>Согласие</label><select name="photo_meta[m__ID__][consent]" data-consent><option value="pending" selected>не проверено (не показывать)</option><option value="yes">да</option><option value="general">общий план</option><option value="no">нет</option></select></div>
              </div>
              <div class="a-photo-tools"><label class="a-check small"><input type="radio" name="cover_id" value="__ID__"><span>Обложка</span></label><button type="button" data-up>↑</button><button type="button" data-down>↓</button><button type="button" data-remove>Убрать</button></div>
            </div>
          </li>
        </template>
      </div>
    </section>

    <section class="a-section"><h2>Итоги</h2>
      {{ a.field('Итоги конференции', 'results_ru', conf.results_ru, {rows: 6, wide: true}) }}
      {{ a.field('Итоги по-английски', 'results_en', conf.results_en, {rows: 4, wide: true}) }}
    </section>
  </div>
  <div class="a-savebar"><button class="a-btn primary" type="submit">Сохранить</button><a class="a-link" href="/admin/conferences">К списку</a></div>
</form>
{% if not isNew %}
<form method="post" action="/admin/conferences/{{ conf.id }}/delete" data-confirm="Удалить конференцию?" class="a-danger"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="a-link danger" type="submit">Удалить конференцию</button></form>
{% endif %}
{% endblock %}
