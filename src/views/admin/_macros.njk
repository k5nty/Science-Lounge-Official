{% macro field(label, name, value, o) %}
  {%- set o = o or {} -%}
  <div class="a-field{{ ' wide' if o.wide }}">
    <label for="f-{{ name | replace('[', '-') | replace(']', '') }}">{{ label }}{% if o.required %} <span class="req">*</span>{% endif %}</label>
    {% if o.rows %}
      <textarea id="f-{{ name | replace('[', '-') | replace(']', '') }}" name="{{ name }}" rows="{{ o.rows }}" {% if o.max %}maxlength="{{ o.max * 2 }}" data-count="{{ o.max }}"{% endif %} {% if o.required %}required{% endif %} {% if o.ph %}placeholder="{{ o.ph }}"{% endif %}>{{ value }}</textarea>
    {% else %}
      <input type="{{ o.type or 'text' }}" id="f-{{ name | replace('[', '-') | replace(']', '') }}" name="{{ name }}" value="{{ value }}" {% if o.max %}maxlength="{{ o.max * 2 }}" data-count="{{ o.max }}"{% endif %} {% if o.required %}required{% endif %} {% if o.ph %}placeholder="{{ o.ph }}"{% endif %} {% if o.list %}list="{{ o.list }}"{% endif %} {% if o.min is defined %}min="{{ o.min }}"{% endif %}>
    {% endif %}
    {% if o.hint %}<span class="a-hint">{{ o.hint }}</span>{% endif %}
  </div>
{% endmacro %}

{% macro check(label, name, on, hint) %}
  <label class="a-check"><input type="checkbox" name="{{ name }}" value="1" {% if on %}checked{% endif %}><span>{{ label }}{% if hint %}<small>{{ hint }}</small>{% endif %}</span></label>
{% endmacro %}

{# Single image/file picker. `purpose`: photo | portrait | team | autograph | poster | file | video #}
{% macro picker(label, name, media, purpose, o) %}
  {%- set o = o or {} -%}
  <div class="a-field a-picker" data-picker data-purpose="{{ purpose }}" data-accept="{{ o.accept or 'image/*' }}">
    <span class="a-label">{{ label }}</span>
    <input type="hidden" name="{{ name }}" value="{{ media.id if media else '' }}">
    <div class="a-picker-body">
      <div class="a-thumb" data-thumb>{% if media and media.thumb %}<img src="{{ media.thumb }}" alt="">{% elif media %}<span class="mono">{{ media.orig_name or 'файл' }}</span>{% endif %}</div>
      <div class="a-picker-actions">
        <label class="a-btn">Выбрать файл<input type="file" accept="{{ o.accept or 'image/*' }}" hidden></label>
        <button type="button" class="a-btn ghost" data-clear {% if not media %}hidden{% endif %}>Убрать</button>
        <span class="a-status" data-status></span>
      </div>
    </div>
    {% if o.hint %}<span class="a-hint">{{ o.hint }}</span>{% endif %}
  </div>
{% endmacro %}

{% macro stateBadge(state, visible) %}
  {% if state == 'published' %}<span class="a-badge ok">опубликован</span>
  {% elif state == 'scheduled' %}<span class="a-badge {{ 'ok' if visible else 'warn' }}">{{ 'опубликован по расписанию' if visible else 'ждёт даты' }}</span>
  {% else %}<span class="a-badge">черновик</span>{% endif %}
{% endmacro %}
