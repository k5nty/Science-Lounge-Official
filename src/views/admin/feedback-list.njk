{% extends "layouts/admin.njk" %}
{% block title %}Обращения{% endblock %}
{% block content %}
<div class="a-head"><h1>Обращения</h1>
  <a class="a-btn" href="/admin/feedback/export.csv?type={{ f.type }}&status={{ f.status }}&issue={{ f.issueId or '' }}">Скачать CSV</a></div>

<form method="get" class="a-filters">
  <select name="type" aria-label="Тип"><option value="">Все типы</option>{% for k, v in TYPES %}<option value="{{ k }}" {% if f.type == k %}selected{% endif %}>{{ v }}</option>{% endfor %}</select>
  <select name="status" aria-label="Статус"><option value="">Любой статус</option>{% for k, v in STATUSES %}<option value="{{ k }}" {% if f.status == k %}selected{% endif %}>{{ v }}</option>{% endfor %}</select>
  <select name="issue" aria-label="Выпуск"><option value="">Все выпуски</option>{% for i in issues %}<option value="{{ i.id }}" {% if f.issueId == i.id %}selected{% endif %}>{{ issueNo(i.number) }} · {{ i.title_ru }}</option>{% endfor %}</select>
  <button class="a-btn" type="submit">Показать</button>
</form>

{% if ratingRows | length %}
<div class="a-cards">
  {% for r in ratingRows %}<div class="a-card"><span class="label">{{ issueNo(r.issue.number) }}</span><p class="a-big mono">{{ r.avg | round(1) }}</p><p class="muted">{{ r.n }} отзывов · {{ r.issue.title_ru }}</p></div>{% endfor %}
</div>
{% endif %}

{% if rows | length %}
<table class="a-table">
  <thead><tr><th>Когда</th><th>Тип</th><th>Выпуск</th><th>Оценка</th><th>Текст</th><th>Контакт</th><th>Статус</th></tr></thead>
  <tbody>
  {% for r in rows %}
    <tr class="{{ 'is-new' if r.status == 'new' }}">
      <td class="mono"><a href="/admin/feedback/{{ r.id }}">{{ r.created_at.slice(0, 16).replace('T', ' ') }}</a></td>
      <td>{{ TYPES[r.type] }}</td>
      <td class="mono">{% if r.issue_number %}{{ pad2(r.issue_number) }}{% else %}—{% endif %}</td>
      <td class="mono">{{ r.rating or '—' }}</td>
      <td class="a-text">{{ r.good or r.question or r.what or r.message }}{% if r.better %}<br><span class="muted">Улучшить: {{ r.better }}</span>{% endif %}{% if r.next_topic %}<br><span class="muted">Хотят: {{ r.next_topic }}</span>{% endif %}</td>
      <td>{{ r.name }}{% if r.name and r.contact %}, {% endif %}{{ r.contact }}{% if r.due_at and r.status != 'closed' %}<br><span class="a-badge {{ 'warn' if r.due_at < now else '' }}">до {{ r.due_at.slice(0, 10) }}</span>{% endif %}</td>
      <td>{{ STATUSES[r.status] }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}<p class="empty">Обращений нет.</p>{% endif %}
{% endblock %}
