{% extends "layouts/admin.njk" %}
{% block title %}Команда{% endblock %}
{% block content %}
<div class="a-head"><h1>Команда</h1><a class="a-btn primary" href="/admin/team/new">Добавить человека</a></div>
{% if members | length %}
<table class="a-table"><thead><tr><th>Имя</th><th>Роль</th><th>Кто</th><th>Порядок</th><th>Статус</th></tr></thead><tbody>
{% for m in members %}<tr><td><a href="/admin/team/{{ m.id }}"><b>{{ m.name_ru }}</b></a>{% if m.is_demo %} <span class="a-badge">демо</span>{% endif %}</td><td>{{ m.role_ru }}</td><td>{{ 'основатель' if m.kind == 'founder' else 'помощник' }}</td><td class="mono">{{ m.position }}</td><td>{% if not m.active %}<span class="a-badge">скрыт</span>{% elif m.alumni %}<span class="a-badge">выпускник</span>{% else %}<span class="a-badge ok">на сайте</span>{% endif %}</td></tr>{% endfor %}
</tbody></table>
{% else %}<p class="empty">Пока никого. Добавьте двух сооснователей: они показываются на странице «О нас».</p>{% endif %}
{% endblock %}
