{% extends "layouts/admin.njk" %}
{% block title %}Лекторы{% endblock %}
{% block content %}
<div class="a-head"><h1>Лекторы</h1><a class="a-btn primary" href="/admin/lecturers/new">Новый лектор</a></div>
{% if lecturers | length %}
<table class="a-table">
  <thead><tr><th></th><th>Имя</th><th>Должность, организация</th><th>Область</th><th>Выпусков</th></tr></thead>
  <tbody>
  {% for l in lecturers %}
    <tr>
      <td style="width:56px">{% if l.portrait %}<img class="a-mini" src="/media/img/{{ l.portrait.base }}/{{ (l.portrait.widths | fromjson | first) }}.webp" alt="">{% endif %}</td>
      <td><a href="/admin/lecturers/{{ l.id }}"><b>{{ l.name_ru }}</b></a>{% if l.is_demo %} <span class="a-badge">демо</span>{% endif %}</td>
      <td>{{ l.role_ru }}{% if l.org_ru %}, {{ l.org_ru }}{% endif %}</td>
      <td>{{ l.area }}</td>
      <td class="mono">{{ counts.get(l.id) or 0 }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}<p class="empty">Лекторов пока нет.</p>{% endif %}
{% endblock %}
