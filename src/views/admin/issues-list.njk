{% extends "layouts/admin.njk" %}
{% import "admin/_macros.njk" as a %}
{% block title %}Выпуски{% endblock %}
{% block content %}
<div class="a-head"><h1>Выпуски</h1><a class="a-btn primary" href="/admin/issues/new">Новый выпуск</a></div>
{% if issues | length %}
<table class="a-table">
  <thead><tr><th>№</th><th>Тема</th><th>EN</th><th>Дата</th><th>Лектор</th><th>Статус</th><th>Оценка</th><th></th></tr></thead>
  <tbody>
  {% for i in issues %}
    {% set r = ratings.get(i.id) %}
    <tr>
      <td class="mono">{{ pad2(i.number) }}</td>
      <td><a href="/admin/issues/{{ i.id }}"><b>{{ i.title_ru }}</b></a>{% if i.is_demo %} <span class="a-badge">демо</span>{% endif %}</td>
      <td>{% if i.title_en and i.thought_en %}<span class="a-badge ok">EN</span>{% elif i.title_en %}<span class="a-badge warn">EN</span>{% else %}<span class="a-badge">нет</span>{% endif %}</td>
      <td class="mono">{{ dShort(i.start_at) }}.{{ i.start_at.slice(0,4) }} {{ dTime(i.start_at) }}</td>
      <td>{{ i.lecturers | map_names('ru') }}</td>
      <td>{{ a.stateBadge(i.publish_state, visible[i.id]) }}{% if i.status_flag %} <span class="a-badge warn">{{ {'moved': 'перенесено', 'cancelled': 'отменено', 'sold_out': 'мест нет'}[i.status_flag] }}</span>{% endif %}</td>
      <td class="mono">{% if r %}{{ r.avg | round(1) }} ({{ r.n }}){% else %}—{% endif %}</td>
      <td class="a-actions">
        <a href="/admin/issues/{{ i.id }}/preview">Предпросмотр</a>
        {% if i.publish_state == 'published' %}<a href="/vypusk/{{ i.slug }}" target="_blank" rel="noopener">На сайте ↗</a>{% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty">Выпусков пока нет. <a href="/admin/issues/new">Добавьте первый</a>.</p>
{% endif %}
{% endblock %}
