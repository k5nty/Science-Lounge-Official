{# Shared pieces. Import with context: {% import "partials/macros.njk" as m with context %} #}

{% macro portrait(lecturer, opts) %}
  {%- set o = opts or {} -%}
  {%- set name = L(lecturer, 'name') -%}
  <div class="portrait{{ ' color' if o.color }}{{ ' ph' if not lecturer.portrait }}">
    {%- if lecturer.portrait -%}
      {{ picture(lecturer.portrait, {sizes: o.sizes or '(max-width: 640px) 45vw, 200px', alt: name, src: o.src or 480, eager: o.eager}) }}
    {%- else -%}
      <span class="ini" aria-hidden="true">{{ initials(name) }}</span>
    {%- endif -%}
  </div>
{% endmacro %}

{% macro statusLabel(status) %}<span class="status {{ status }}">{{ t('status.' + status) }}</span>{% endmacro %}

{% macro issueCard(i) %}
  {%- set lecturer = i.lecturer -%}
  <a class="card" href="{{ url('issue', {slug: i.slug}) }}">
    {% if i.cover %}<div class="card-photo">{{ picture(i.cover, {sizes: '(max-width: 640px) 90vw, 360px', src: 480, alt: ''}) }}</div>{% endif %}
    <div class="top"><span class="n mono">{{ issueNo(i.number) }}</span><span class="label">{{ fx.dl(i.start_at) }}</span></div>
    <h3>{{ L(i, 'title') }}</h3>
    {% set thought = L(i, 'thought') or (L(i, 'announce') | striptags | truncate(150)) %}
    {% if thought %}<p class="thought">{{ thought }}</p>{% endif %}
    {% if lecturer %}<span class="by">{{ i.lecturers | map_names(lang) }}{% if i.tags | length %} <span class="muted">· {% for tg in i.tags %}{{ tagName(tg) }}{{ ', ' if not loop.last }}{% endfor %}</span>{% endif %}</span>{% endif %}
  </a>
{% endmacro %}

{% macro hidden(token, lang) %}
  <input type="hidden" name="_t" value="{{ token }}">
  <input type="hidden" name="lang" value="{{ lang }}">
  <div class="hp" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
{% endmacro %}

{% macro rating(prefix) %}
  <div class="rate" role="radiogroup">
    {% for n in [1,2,3,4,5] %}
      <input type="radio" name="rating" id="{{ prefix }}-r{{ n }}" value="{{ n }}" required><label for="{{ prefix }}-r{{ n }}">{{ n }}</label>
    {% endfor %}
  </div>
{% endmacro %}

{% macro newsItem(n, level=3) %}
  <article class="news-item{{ ' has-photo' if n.image }}">
    {% if n.image %}<div class="news-photo">{{ picture(n.image, {sizes: '(max-width: 640px) 90vw, 240px', src: 480, alt: ''}) }}</div>{% endif %}
    <div class="news-body">
      <p class="news-meta"><time datetime="{{ n.published_at }}">{{ fx.dl(n.published_at) }}</time>{% if n.source_name %}<span>{{ n.source_name }}</span>{% endif %}</p>
      <h{{ level }}>{% if n.source_url %}<a href="{{ n.source_url }}" target="_blank" rel="noopener">{{ L(n, 'title') }}</a>{% else %}{{ L(n, 'title') }}{% endif %}</h{{ level }}>
      {% if L(n, 'summary') %}<p class="news-text">{{ L(n, 'summary') }}</p>{% endif %}
      {% if n.source_url %}<a class="news-src" href="{{ n.source_url }}" target="_blank" rel="noopener">{{ t('news.source') }}{% if n.source_name %}: {{ n.source_name }}{% endif %} ↗</a>{% endif %}
    </div>
  </article>
{% endmacro %}
