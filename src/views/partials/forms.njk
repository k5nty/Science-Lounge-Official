{% import "partials/macros.njk" as m with context %}

{% macro review(issue, quick) %}
<form class="fb{{ ' review-quick' if quick }}" method="post" action="/forms/review" data-form="review" novalidate>
  <input type="hidden" name="issue" value="{{ issue.id }}">
  {{ m.hidden(formToken, lang) }}
  <fieldset class="field">
    <legend>{{ t('fb.rating') }} <span class="muted">({{ t('fb.rating_hint') }})</span></legend>
    {{ m.rating('rv' + issue.id) }}
  </fieldset>
  <div class="field"><label for="rv{{ issue.id }}-good">{{ t('fb.good') }}</label><textarea id="rv{{ issue.id }}-good" name="good" maxlength="1500" rows="3"></textarea></div>
  <div class="field"><label for="rv{{ issue.id }}-better">{{ t('fb.better') }}</label><textarea id="rv{{ issue.id }}-better" name="better" maxlength="1500" rows="3"></textarea></div>
  <div class="field"><label for="rv{{ issue.id }}-next">{{ t('fb.next') }}</label><input type="text" id="rv{{ issue.id }}-next" name="next" maxlength="300"></div>
  <div class="field"><label for="rv{{ issue.id }}-grade">{{ t('fb.grade') }}</label>
    <select id="rv{{ issue.id }}-grade" name="grade"><option value="">{{ t('fb.grade_none') }}</option>{% for g in [7,8,9,10,11] %}<option value="{{ g }}">{{ g }}</option>{% endfor %}</select></div>
  <p class="hint muted" style="font-size:13px">{{ t('fb.anon') }}</p>
<p class="hint muted" style="font-size:12.5px"><a href="/politika">{{ t('fb.policy') }}</a></p>
  <div><button class="btn primary" type="submit" data-goal="review">{{ t('btn.send') }}</button></div>
  <div class="out" aria-live="polite"></div>
</form>
{% endmacro %}

{% macro question(issue) %}
<form class="fb" method="post" action="/forms/question" data-form="question" novalidate>
  <input type="hidden" name="issue" value="{{ issue.id }}">
  {{ m.hidden(formToken, lang) }}
  <div class="field"><label for="q{{ issue.id }}">{{ t('fb.question_label') }}</label>
    <textarea id="q{{ issue.id }}" name="question" required maxlength="1500" rows="4"></textarea>
    <span class="hint">{{ t('fb.question_hint') }}</span></div>
  <div class="field"><label for="q{{ issue.id }}-name">{{ t('fb.name_opt') }}</label><input type="text" id="q{{ issue.id }}-name" name="name" maxlength="120" autocomplete="given-name"></div>
<p class="hint muted" style="font-size:12.5px"><a href="/politika">{{ t('fb.policy') }}</a></p>
  <div><button class="btn primary" type="submit">{{ t('btn.send') }}</button></div>
  <div class="out" aria-live="polite"></div>
</form>
{% endmacro %}

{% macro suggestInline() %}
<form class="fb" method="post" action="/forms/suggest" data-form="suggest" style="max-width:none" novalidate>
  {{ m.hidden(formToken, lang) }}
  <div class="field"><label for="home-suggest">{{ t('home.suggest_label') }}</label>
    <div class="suggest"><input type="text" id="home-suggest" name="what" required maxlength="300" placeholder="{{ t('home.suggest_ph') }}"><button class="btn primary" type="submit">{{ t('btn.suggest') }}</button></div></div>
  <p class="hint muted" style="font-size:12.5px"><a href="/politika">{{ t('fb.policy') }}</a></p>
  <div class="out" aria-live="polite"></div>
</form>
{% endmacro %}

{% macro suggest() %}
<form class="fb" method="post" action="/forms/suggest" data-form="suggest" novalidate>
  {{ m.hidden(formToken, lang) }}
  <div class="field"><label for="sg-what">{{ t('fb.who') }}</label><input type="text" id="sg-what" name="what" required maxlength="300"></div>
  <div class="field"><label for="sg-why">{{ t('fb.why') }}</label><textarea id="sg-why" name="why" maxlength="1500" rows="4"></textarea></div>
  <div class="field"><label for="sg-contact">{{ t('fb.contact_opt') }}</label><input type="text" id="sg-contact" name="contact" maxlength="200" data-consent-trigger="sg-consent"></div>
  <label class="consent" id="sg-consent" hidden><input type="checkbox" name="consent" value="1"><span>{{ t('fb.consent', {policy: ''}) }}<a href="/politika">{{ t('fb.policy') }}</a></span></label>
  <div><button class="btn primary" type="submit">{{ t('btn.send') }}</button></div>
  <div class="out" aria-live="polite"></div>
</form>
{% endmacro %}

{% macro contact() %}
<form class="fb" method="post" action="/forms/contact" data-form="contact" novalidate>
  {{ m.hidden(formToken, lang) }}
  <div class="field"><label for="ct-kind">{{ t('fb.kind') }}</label>
    <select id="ct-kind" name="kind"><option>{{ t('fb.kind_lecturer') }}</option><option>{{ t('fb.kind_partner') }}</option><option>{{ t('fb.kind_other') }}</option></select></div>
  <div class="field"><label for="ct-name">{{ t('fb.name') }}</label><input type="text" id="ct-name" name="name" required maxlength="120" autocomplete="name"></div>
  <div class="field"><label for="ct-contact">{{ t('fb.contact_req') }}</label><input type="text" id="ct-contact" name="contact" required maxlength="200"></div>
  <div class="field"><label for="ct-msg">{{ t('fb.message') }}</label><textarea id="ct-msg" name="message" required maxlength="3000" rows="5"></textarea></div>
  <label class="consent"><input type="checkbox" name="consent" value="1" required><span>{{ t('fb.consent', {policy: ''}) }}<a href="/politika">{{ t('fb.policy') }}</a></span></label>
  <div><button class="btn primary" type="submit">{{ t('btn.send') }}</button></div>
  <div class="out" aria-live="polite"></div>
</form>
{% endmacro %}

{% macro photoRemoval(where) %}
<form class="fb" method="post" action="/forms/photo_removal" data-form="photo_removal" novalidate>
  {{ m.hidden(formToken, lang) }}
  <div class="field"><label for="pr-where">{{ t('photo.where') }}</label><input type="text" id="pr-where" name="where" required maxlength="300" value="{{ where }}"></div>
  <div class="field"><label for="pr-msg">{{ t('photo.what') }}</label><textarea id="pr-msg" name="message" required maxlength="2000" rows="4"></textarea></div>
  <div class="field"><label for="pr-contact">{{ t('photo.contact') }}</label><input type="text" id="pr-contact" name="contact" required maxlength="200"></div>
  <label class="consent"><input type="checkbox" name="consent" value="1" required><span>{{ t('fb.consent', {policy: ''}) }}<a href="/politika">{{ t('fb.policy') }}</a></span></label>
  <div><button class="btn primary" type="submit">{{ t('btn.send') }}</button></div>
  <div class="out" aria-live="polite"></div>
</form>
{% endmacro %}
