<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="csrf" content="{{ csrf }}">
<title>{% block title %}Админка{% endblock %} · Science Lounge</title>
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="{{ asset('css/site.css') }}">
<link rel="stylesheet" href="{{ asset('css/admin.css') }}">
</head>
<body class="admin">
{% if user %}
<header class="a-bar">
  <div class="a-wrap">
    <a class="a-brand" href="/admin">Science <i>Lounge</i> <span>админка</span></a>
    <nav class="a-nav" aria-label="Разделы админки">
      <a href="/admin/issues" {% if adminPath.indexOf('/issues') == 0 %}aria-current="page"{% endif %}>Выпуски</a>
      <a href="/admin/lecturers" {% if adminPath.indexOf('/lecturers') == 0 %}aria-current="page"{% endif %}>Лекторы</a>
      <a href="/admin/conferences" {% if adminPath.indexOf('/conferences') == 0 %}aria-current="page"{% endif %}>Конференции</a>
      <a href="/admin/news" {% if adminPath.indexOf('/news') == 0 %}aria-current="page"{% endif %}>Новости</a>
      <a href="/admin/team" {% if adminPath.indexOf('/team') == 0 %}aria-current="page"{% endif %}>Команда</a>
      {% if user.role == 'admin' %}
      <a href="/admin/feedback" {% if adminPath.indexOf('/feedback') == 0 %}aria-current="page"{% endif %}>Обращения</a>
      <a href="/admin/settings" {% if adminPath.indexOf('/settings') == 0 %}aria-current="page"{% endif %}>Настройки</a>
      <a href="/admin/users" {% if adminPath.indexOf('/users') == 0 %}aria-current="page"{% endif %}>Люди</a>
      <a href="/admin/backups" {% if adminPath.indexOf('/backups') == 0 %}aria-current="page"{% endif %}>Копии</a>
      {% endif %}
      <a href="/admin/help" {% if adminPath.indexOf('/help') == 0 %}aria-current="page"{% endif %}>Как вести сайт</a>
    </nav>
    <div class="a-user">
      <a href="/" target="_blank" rel="noopener">Сайт ↗</a>
      <span class="muted">{{ user.name or user.email }}</span>
      <form method="post" action="/admin/logout" style="display:inline"><input type="hidden" name="_csrf" value="{{ csrf }}"><button class="a-link" type="submit">Выйти</button></form>
    </div>
  </div>
</header>
{% endif %}
<main class="a-main">
  {% if flash %}<div class="a-flash {{ flash.kind }}" role="status">{{ flash.message }}</div>{% endif %}
  {% block content %}{% endblock %}
</main>
<script src="{{ asset('js/admin.js') }}" defer></script>
</body>
</html>
