<!doctype html>
<html lang="{{ lang }}" data-theme="{{ theme }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ page.title }}</title>
<meta name="description" content="{{ page.description }}">
<meta name="theme-color" content="#F6F7F5" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121416" media="(prefers-color-scheme: dark)">
{% if page.noindex %}<meta name="robots" content="noindex, follow">{% endif %}
{% if page.canonical %}<link rel="canonical" href="{{ page.canonical }}">{% endif %}
{% if page.ruUrl %}<link rel="alternate" hreflang="ru" href="{{ page.ruUrl }}">{% endif %}
{% if page.enUrl %}<link rel="alternate" hreflang="en" href="{{ page.enUrl }}">{% endif %}
<meta property="og:site_name" content="{{ settings.site_title }}">
<meta property="og:type" content="{{ page.type or 'website' }}">
<meta property="og:title" content="{{ page.title }}">
<meta property="og:description" content="{{ page.description }}">
{% if page.canonical %}<meta property="og:url" content="{{ page.canonical }}">{% endif %}
<meta property="og:image" content="{{ page.image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="{{ 'en_US' if lang == 'en' else 'ru_RU' }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="{{ settings.site_title }}" href="/feed.xml">
{% if theme == 'journal' %}
<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/golos-text-cyrillic-wght-normal.woff2">
<link rel="preload" as="font" type="font/woff2" crossorigin href="/assets/fonts/literata-cyrillic-wght-normal.woff2">
{% endif %}
<link rel="stylesheet" href="{{ asset('css/site.css') }}">
{% if themeCss %}<link rel="stylesheet" href="{{ asset(themeCss) }}">{% endif %}
{% if hasMath %}<link rel="stylesheet" href="/vendor/katex/katex.min.css">{% endif %}
{% if page.jsonld %}<script type="application/ld+json">{{ page.jsonld | jsonld }}</script>{% endif %}
</head>
<body>
<a class="skip" href="#main">{{ t('skip') }}</a>
{% block topbar %}{% endblock %}
{% if themePart('header') %}{% include themePart('header') %}{% else %}{% include "partials/header.njk" %}{% endif %}

<main id="main" class="wrap" tabindex="-1">
{% block content %}{% endblock %}
</main>

{% if themePart('footer') %}{% include themePart('footer') %}{% else %}{% include "partials/footer.njk" %}{% endif %}

{% if analytics.metrika %}
<div class="cookie" id="cookie" hidden role="dialog" aria-label="Cookie">
  <p>{{ t('cookie.text') }}</p>
  <div class="actions"><button class="btn primary" type="button" data-cookie="yes">{{ t('cookie.ok') }}</button><button class="btn" type="button" data-cookie="no">{{ t('cookie.no') }}</button></div>
</div>
{% endif %}
{% if themeSwitcher %}{% include "partials/theme-switcher.njk" %}{% endif %}
<script src="{{ asset('js/site.js') }}" defer
  {% if analytics.metrika %}data-ym="{{ analytics.metrika }}"{% endif %}></script>
{% if themeJs %}<script src="{{ asset(themeJs) }}" defer></script>{% endif %}
{% if analytics.umamiSrc and analytics.umamiId %}<script defer src="{{ analytics.umamiSrc }}" data-website-id="{{ analytics.umamiId }}"></script>{% endif %}
{% block scripts %}{% endblock %}
</body>
</html>
