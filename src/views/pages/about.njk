{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as m with context %}
{% import "partials/forms.njk" as f with context %}

{% macro person(p) %}
  <div class="founder">
    <div class="portrait{{ ' ph' if not p.photo }}">{% if p.photo %}{{ picture(p.photo, {sizes: '130px', src: 480, alt: L(p, 'name')}) }}{% else %}<span class="ini" aria-hidden="true">{{ initials(L(p, 'name')) }}</span>{% endif %}</div>
    <div>
      <b>{{ L(p, 'name') }}</b>
      <span class="roles">{% for r in L(p, 'role').split(',') %}{% if r | trim %}<span class="role-chip">{{ r | trim }}</span>{% endif %}{% endfor %}{% if p.alumni %}<span class="role-chip">{{ t('about.alumni') }}</span>{% endif %}</span>
      {% if L(p, 'bio') %}<p>{{ L(p, 'bio') }}</p>{% endif %}
      {% if p.links | length %}<div class="links-line">{% for l in p.links %}<a href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label or (l.url | hostname) }} ↗</a>{% endfor %}</div>{% endif %}
    </div>
  </div>
{% endmacro %}

{% block content %}
<div class="sec-head"><h1 class="page-title">{{ t('about.h') }}</h1><span class="label">2025</span></div>

<section class="two" style="margin-top:0">
  <div class="prose">
    {% if story %}{{ story | safe }}
    {% else %}<p>{{ t('about.default') }}</p>{% endif %}
  </div>
  <div>
    {% if stats.lectures or stats.listeners %}
    <div class="facts n2" role="list">
      {% for key in ['lectures', 'listeners', 'regions'] %}
        {% if stats[key] %}<div role="listitem"><b class="mono">{{ stats[key] }}</b><span class="label">{{ t('stat.' + key) }}</span></div>{% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>

{% if founders | length %}
<section>
  <div class="sec-head"><h2>{{ t('about.founders_h') }}</h2></div>
  <div class="founders">{% for p in founders %}{{ person(p) }}{% endfor %}</div>
</section>
{% endif %}

{% if helpers | length %}
<section>
  <div class="sec-head"><h2>{{ t('about.team_h') }}</h2></div>
  <div class="founders">{% for p in helpers %}{{ person(p) }}{% endfor %}</div>
</section>
{% endif %}

{% if thanks %}
<section><div class="sec-head"><h2>{{ t('about.thanks') }}</h2></div><div class="prose">{{ thanks | safe }}</div></section>
{% endif %}

{% if tgPost %}
<section>
  <div class="sec-head"><h2>{{ t('home.last_post') }}</h2>{% if channelUrl %}<a href="{{ channelUrl }}" target="_blank" rel="noopener">{{ t('nav.channel') }} →</a>{% endif %}</div>
  <div class="tg-post" data-tg-post="{{ tgPost }}"></div>
</section>
{% endif %}

<section class="two" id="vystupit">
  <div>
    <div class="sec-head"><h2>{{ t('about.speak') }}</h2></div>
    <div class="prose">{{ speak | safe }}</div>
    {% if settings.contact_email %}<p style="margin-top:16px"><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p>{% endif %}
    {% if channelUrl %}<p style="margin-top:8px"><a href="{{ channelUrl }}" target="_blank" rel="noopener">{{ t('nav.channel') }} →</a></p>{% endif %}
  </div>
  <div id="contact">
    <div class="sec-head"><h2>{{ t('about.contact') }}</h2></div>
    {{ f.contact() }}
  </div>
</section>
{% endblock %}
