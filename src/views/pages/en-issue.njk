{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as m with context %}
{% block content %}
<header class="issue-head">
  <div class="issue-no" aria-hidden="true"><small>№</small>{{ pad2(issue.number) }}</div>
  <div>{{ m.statusLabel(status) }}<h1>{{ L(issue, 'title') }}</h1></div>
</header>
<div class="byline">
  <span><b>{{ fx.dl(issue.start_at) }}</b>, {{ fx.dwd(issue.start_at) }}, {{ dTime(issue.start_at) }}</span>
  {% if L(issue, 'place') %}<span>{{ L(issue, 'place') }}</span>{% endif %}
  {% if issue.past and issue.listeners %}<span><b>{{ issue.listeners }}</b> {{ t('stat.listeners') }}</span>{% endif %}
</div>
{% if issue.past and L(issue, 'thought') %}<p class="thesis" data-label="{{ t('issue.thought') }}">{{ L(issue, 'thought') }}</p>
{% elif L(issue, 'announce') %}<div class="lead-text" style="margin-top:28px"><p>{{ L(issue, 'announce') }}</p></div>{% endif %}
<div class="speakers" style="margin-top:28px;max-width:640px">
  {% for l in issue.lecturers %}
    <div class="speaker-box">{{ m.portrait(l) }}<span><span class="label">{{ t('issue.lecturer') }}</span><b>{{ L(l, 'name') }}</b><p>{{ L(l, 'role') }}{% if L(l, 'org') %}, {{ L(l, 'org') }}{% endif %}</p>{% if L(l, 'bio') %}<p class="bio">{{ L(l, 'bio') }}</p>{% endif %}</span></div>
  {% endfor %}
</div>
<div class="actions">
  {% if not issue.past %}<a class="btn primary" href="/vypusk/{{ issue.slug }}.ics" data-goal="calendar">{{ t('btn.calendar') }}</a>{% endif %}
  {% if issue.reg_enabled and issue.reg_url and not issue.past %}<a class="btn" href="{{ issue.reg_url }}" target="_blank" rel="noopener">{{ t('btn.register') }}</a>{% endif %}
  {% if issue.past %}<a class="btn" href="/vypusk/{{ issue.slug }}" hreflang="ru">{{ t('issue.writeup_link') }}</a>{% endif %}
</div>
{% if issue.past %}<p class="muted" style="margin-top:12px;font-size:14px">{{ t('issue.writeup') }}.</p>{% endif %}
{% endblock %}
