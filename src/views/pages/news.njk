{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as m with context %}

{% block content %}
<div class="sec-head"><h1 class="page-title">{{ t('news.h') }}</h1></div>
{% if newsList | length %}
<div class="news-list">{% for n in newsList %}{{ m.newsItem(n, 2) }}{% endfor %}</div>
{% if pageCount > 1 %}
<nav class="news-pager" aria-label="{{ t('news.h') }}">
  {% if pageNo > 1 %}<a class="btn" rel="prev" href="{{ url('news') }}{{ '?page=' + (pageNo - 1) if pageNo > 2 else '' }}">← {{ t('news.newer') }}</a>{% endif %}
  <span class="news-pos">{{ pageNo }} / {{ pageCount }}</span>
  {% if pageNo < pageCount %}<a class="btn" rel="next" href="{{ url('news') }}?page={{ pageNo + 1 }}">{{ t('news.older') }} →</a>{% endif %}
</nav>
{% endif %}
{% else %}
<p class="empty">{{ t('news.empty') }}</p>
{% endif %}
{% endblock %}
