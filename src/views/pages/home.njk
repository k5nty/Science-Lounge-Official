{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as m with context %}
{% import "partials/forms.njk" as f with context %}

{% block content %}
{% if themePart('home') %}
  {% include themePart('home') %}
{% else %}
{% if lead %}
  {% set lecturer = lead.lecturer %}
  {% set leadUrl = url('issue', {slug: lead.slug}) %}
  <section class="lead-issue" aria-labelledby="lead-t">
    <div>
      <span class="status {{ 'soon' if isNext else 'past' }}">{{ t('status.next') if isNext else t('status.last') }}</span>
      <div class="issue-no" aria-hidden="true"><small>№</small>{{ pad2(lead.number) }}</div>
      <h1 id="lead-t"><a href="{{ url('issue', {slug: lead.slug}) }}">{{ L(lead, 'title') }}</a></h1>
      <div class="when">
        <b>{{ fx.dl(lead.start_at) }}</b><span>{{ fx.dwd(lead.start_at) }}, {{ dTime(lead.start_at) }}</span>
        {% if L(lead, 'place') %}<span>{{ L(lead, 'place') }}</span>{% endif %}
      </div>
      {% if leadStatus == 'cancelled' or leadStatus == 'moved' or leadStatus == 'sold_out' %}<p style="margin-top:12px">{{ m.statusLabel(leadStatus) }}</p>{% endif %}
      <div class="lead-text">{{ leadHtml | safe }}</div>
      <div class="actions" style="margin-top:22px">
        {% if isNext %}
          <a class="btn primary" href="/vypusk/{{ lead.slug }}.ics" data-goal="calendar">{{ t('btn.calendar') }}</a>
          {% if lead.reg_enabled and lead.reg_url and leadStatus != 'sold_out' and leadStatus != 'cancelled' %}<a class="btn" href="{{ lead.reg_url }}" target="_blank" rel="noopener" data-goal="register">{{ t('btn.register') }}</a>{% endif %}
          {% if lang == 'ru' %}<a class="btn" href="{{ url('issue', {slug: lead.slug}) }}#ask">{{ t('btn.ask') }}</a>{% else %}<a class="btn" href="{{ url('issue', {slug: lead.slug}) }}">{{ t('btn.details') }}</a>{% endif %}
        {% else %}
          <a class="btn primary" href="{{ url('issue', {slug: lead.slug}) }}">{{ t('btn.read') }}</a>
          <a class="btn" href="{{ url('schedule') }}">{{ t('nav.schedule') }}</a>
        {% endif %}
      </div>
    </div>
    {% if lecturer %}
    <a class="lead-side" href="{{ leadUrl }}">
      {{ m.portrait(lecturer, {eager: true, sizes: '(max-width: 820px) 80vw, 400px', src: 960}) }}
      <span class="who"><b>{{ L(lecturer, 'name') }}</b><span>{{ L(lecturer, 'role') }}{% if L(lecturer, 'org') %}, {{ L(lecturer, 'org') }}{% endif %}</span></span>
    </a>
    {% endif %}
  </section>
{% else %}
  <section>
    <h1 class="page-title">{{ t('home.empty_h') }}</h1>
    <p class="lead-text">{{ t('home.empty_p') }}</p>
    {% if channelUrl %}<p style="margin-top:18px"><a class="btn primary" href="{{ channelUrl }}" target="_blank" rel="noopener">{{ t('nav.channel') }}</a></p>{% endif %}
  </section>
{% endif %}

{% if stats.lectures or stats.listeners or stats.regions %}
<section aria-label="{{ settings.site_title }}">
  <div class="facts" role="list">
    {% for key in ['lectures', 'listeners', 'regions'] %}
      {% if stats[key] %}<div role="listitem"><b class="mono">{{ stats[key] }}</b><span class="label">{{ t('stat.' + key) }}</span></div>{% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if latest | length %}
<section>
  <div class="sec-head"><h2>{{ t('home.latest') }}</h2><a href="{{ url('archive') }}">{{ t('btn.all_issues') }} →</a></div>
  <div class="cards">{% for i in latest %}{{ m.issueCard(i) }}{% endfor %}</div>
</section>
{% endif %}

{% if newsList | length %}
<section>
  <div class="sec-head"><h2>{{ t('news.h') }}</h2><a href="{{ url('news') }}">{{ t('news.all') }} →</a></div>
  <div class="news-list">{% for n in newsList %}{{ m.newsItem(n) }}{% endfor %}</div>
</section>
{% endif %}

<section>
  <div class="sec-head"><h2>{{ t('home.suggest_h') }}</h2></div>
  {{ f.suggestInline() }}
</section>

{% if tgPost %}
<section>
  <div class="sec-head"><h2>{{ t('home.last_post') }}</h2>{% if channelUrl %}<a href="{{ channelUrl }}" target="_blank" rel="noopener">{{ t('nav.channel') }} →</a>{% endif %}</div>
  <div class="tg-post" data-tg-post="{{ tgPost }}"></div>
</section>
{% endif %}
{% endif %}
{% endblock %}
