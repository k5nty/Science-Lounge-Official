{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as m with context %}

{% block content %}
{% if not conf %}
  <div class="sec-head"><h1 class="page-title">National Letovo Engineers</h1></div>
  <p class="empty">{{ t('conf.empty') }}</p>
{% else %}
  {% set base = '/en/conference/' if lang == 'en' else '/konferentsiya/' %}
  <header class="issue-head" style="grid-template-columns:1fr">
    <div>
      <span class="label">{{ conf.year }}</span>
      <h1>{{ L(conf, 'title') }}</h1>
    </div>
  </header>
  <div class="byline">
    {% if conf.date_start %}<span><b>{{ dRangeEn(conf.date_start, conf.date_end) if lang == 'en' else dRange(conf.date_start, conf.date_end) }}</b></span>{% endif %}
    {% set place = L(conf, 'place') %}{% if place %}<span>{{ place }}</span>{% endif %}
    {% if conf.regions | length %}<span><b>{{ conf.regions | length }}</b> {{ t('stat.regions') }}</span>{% endif %}
    {% if conf.posters | length %}<span><b>{{ conf.posters | length }}</b> {{ 'posters' if lang == 'en' else 'постеров' }}</span>{% endif %}
  </div>

  {% if confs | length > 1 %}
  <div class="year-nav" style="margin-top:20px"><span class="label" style="align-self:center">{{ t('conf.other') }}</span>
    {% for c in confs %}<a class="chip" href="{{ base }}{{ c.year }}" {% if c.id == conf.id %}aria-current="true"{% endif %}>{{ c.year }}</a>{% endfor %}
  </div>
  {% endif %}

  {% if conf.cover %}
    <div class="cover-photo" style="margin-top:24px">{{ picture(conf.cover, {sizes: '(max-width: 1160px) 100vw, 1160px', src: 1600, eager: true}) }}</div>
    {% if conf.cover.credit %}<p class="cover-cap">{{ t('photo.by') }}: {{ conf.cover.credit }}</p>{% endif %}
  {% endif %}

  {% if intro %}<section class="prose" style="margin-top:36px">{{ intro | safe }}</section>{% endif %}

  {% if conf.program | length %}
  <section class="block">
    <h2>{{ t('conf.program') }}</h2>
    <div class="days">
      {% for d in conf.program %}
        <div class="day">
          <h3>{{ d.title or (loop.index ~ ' ' ~ ('day' if lang == 'en' else 'день')) }}{% if d.date %} <span class="mono muted" style="font-size:14px">{{ d.date }}</span>{% endif %}</h3>
          <ul>{% for it in d.items %}<li><time>{{ it.time }}</time><span>{{ it.text }}</span></li>{% endfor %}</ul>
        </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if conf.jury | length %}
  <section class="block">
    <h2>{{ t('conf.jury') }}</h2>
    <div class="jury">
      {% for l in conf.jury %}
        <div class="sp">{{ m.portrait(l) }}<b>{{ L(l, 'name') }}</b><small>{{ L(l, 'role') }}{% if L(l, 'org') %}, {{ L(l, 'org') }}{% endif %}</small></div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if conf.regions | length %}
  <section class="block">
    <h2>{{ t('conf.regions') }}</h2>
    {% if mapSvg %}<div class="russia-map-wrap">{{ mapSvg | safe }}</div>{% endif %}
    <ul class="regions">{% for r in conf.regions %}<li>{{ r.name if r.name else r }}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  {% if conf.posters | length %}
  <section class="block">
    <h2>{{ t('conf.posters') }}</h2>
    <div class="posters">
      {% for p in conf.posters %}
        <div class="poster"><figure>
          {% if p.media %}<a class="frame" href="/media/img/{{ p.media.base }}/{{ (p.media.widths | fromjson | last) }}.webp" data-lightbox data-caption="{{ p.title }}{% if p.authors %} · {{ p.authors }}{% endif %}" style="display:block">{{ picture(p.media, {sizes: '(max-width: 640px) 90vw, 360px', src: 960, alt: p.title}) }}</a>{% endif %}
          <figcaption><b>{{ p.title }}</b>{% if p.authors %}<span class="muted">{{ p.authors }}</span>{% endif %}</figcaption>
        </figure></div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if conf.photos | length %}
  <section class="block">
    <h2>{{ t('conf.photos') }}</h2>
    <div class="gallery">
      {% for p in conf.photos %}
        <a href="/media/img/{{ p.base }}/{{ (p.widths | fromjson | last) }}.webp" data-lightbox data-caption="{{ p.alt }}{% if p.credit %} · {{ t('photo.by') }}: {{ p.credit }}{% endif %}">{{ picture(p, {sizes: '(max-width: 640px) 50vw, 340px', src: 480, alt: p.alt}) }}</a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if results %}
  <section class="block"><h2>{{ t('conf.results') }}</h2><div class="prose">{{ results | safe }}</div></section>
  {% endif %}
{% endif %}
{% endblock %}
