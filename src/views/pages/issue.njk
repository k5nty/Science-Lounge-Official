{% extends "layouts/base.njk" %}
{% import "partials/macros.njk" as m with context %}
{% import "partials/forms.njk" as f with context %}

{% block topbar %}
{% if preview %}<div class="preview-bar"><div class="wrap">Предпросмотр, сайт это не видит. <a href="/admin/issues/{{ issue.id }}">Вернуться к редактированию</a></div></div>{% endif %}
{% endblock %}

{% macro videoBlock(item, label, poster, lecturer) %}
  {% set e = videoEmbed(item.url) %}
  {% if e.kind != 'none' %}
  <div class="vid">
    {% if e.kind == 'link' %}
      <a class="vid-frame" href="{{ e.href }}" target="_blank" rel="noopener" data-goal="video"><span class="play" aria-hidden="true"></span></a>
    {% else %}
      <a class="vid-frame" href="{{ e.href }}" target="_blank" rel="noopener" data-embed="{{ e.kind }}" data-src="{{ e.src }}" data-goal="video">
        {% if poster %}{{ picture(poster, {sizes: '(max-width: 640px) 100vw, 560px', alt: '', src: 960}) }}{% endif %}
        <span class="play" aria-hidden="true"></span>
      </a>
    {% endif %}
    <b>{{ label }}</b>
    {% if e.host %}<span class="label">{{ e.host }}</span>{% endif %}
  </div>
  {% endif %}
{% endmacro %}

{% block content %}
{% set past = issue.past %}
{% set cover = issue.cover %}
{% set st = v.status %}

{% if past and cover %}
  <figure class="cover">
    <div class="cover-photo">{{ picture(cover, {sizes: '(max-width: 1160px) 100vw, 1160px', src: 1600, eager: true, alt: cover.alt}) }}</div>
    <div class="plaque">
      <div class="issue-no" aria-hidden="true"><small>№</small>{{ pad2(issue.number) }}</div>
      <h1>{{ issue.title_ru }}</h1>
    </div>
    {% if cover.credit %}<figcaption class="cover-cap">{{ t('photo.by') }}: {{ cover.credit }}</figcaption>{% endif %}
  </figure>
{% else %}
  <header class="issue-head">
    <div class="issue-no" aria-hidden="true"><small>№</small>{{ pad2(issue.number) }}</div>
    <div>
      <span class="status {{ st if st != 'past' else 'past' }}">{{ t('issue.label') if past else t('issue.announce') }}{% if issue.tags | length %} · {% for tg in issue.tags %}{{ tagName(tg) }}{{ ', ' if not loop.last }}{% endfor %}{% endif %}</span>
      <h1>{{ issue.title_ru }}</h1>
    </div>
  </header>
{% endif %}

<div class="byline">
  <span><b>{{ dLong(issue.start_at) }}</b>, {{ dWd(issue.start_at) }}, {{ dTime(issue.start_at) }}</span>
  {% if issue.place_ru %}<span>{{ issue.place_ru }}</span>{% endif %}
  {% if past and issue.listeners %}<span><b>{{ issue.listeners }}</b> {{ t('stat.listeners') }}</span>{% endif %}
  {% if past and issue.ideas | length %}<span>{{ t('issue.read_min', {n: v.readMin}) }}</span>{% endif %}
  {% if v.rating %}<span class="rating-line">{{ t('issue.rating') }}: <b>{{ v.rating.avg | round(1) }}</b> / 5 · {{ t('issue.rating_n', {n: v.rating.n}) }}</span>{% endif %}
  {% if not past or not cover %}{% if past %}<span class="status past">{{ t('status.past') }}</span>{% else %}{{ m.statusLabel(st) }}{% endif %}{% endif %}
</div>

{% if st == 'cancelled' %}<p class="banner cancelled">{{ t('issue.cancelled_note') }}</p>
{% elif st == 'moved' %}<p class="banner">{{ t('issue.moved_note') }}</p>
{% elif st == 'sold_out' %}<p class="banner">{{ t('issue.sold_out_note') }}</p>{% endif %}

{% if not past %}
  {# ---------- announce ---------- #}
  <div class="grid12">
    <div class="main-col">
      {% if v.announceHtml %}
      <p class="label" style="margin-top:28px">{{ t('issue.about') }}</p>
      <div class="prose" style="margin-top:8px">{{ v.announceHtml | safe }}</div>
      {% endif %}
      <div class="cal-line">
        {% if st != 'cancelled' %}<a class="btn primary" href="/vypusk/{{ issue.slug }}.ics" data-goal="calendar">{{ t('btn.calendar') }}</a>{% endif %}
        {% if issue.reg_enabled and issue.reg_url and st != 'cancelled' and st != 'sold_out' %}<a class="btn" href="{{ issue.reg_url }}" target="_blank" rel="noopener" data-goal="register">{{ t('btn.register') }}</a>{% endif %}
      </div>
      <div class="speakers">
        {% for l in issue.lecturers %}
          <div class="speaker-box">
            {{ m.portrait(l) }}
            <span><span class="label">{{ t('issue.lecturer') }}</span><b>{{ l.name_ru }}</b><p>{{ l.role_ru }}{% if l.org_ru %}, {{ l.org_ru }}{% endif %}</p>{% if l.bio_ru %}<p class="bio">{{ l.bio_ru }}</p>{% endif %}</span>
          </div>
        {% endfor %}
      </div>
      {% if st != 'cancelled' %}
      <section class="block" id="ask" style="margin-top:0">
        <h2>{{ t('issue.q_before') }}</h2>
        {{ f.question(issue) }}
      </section>
      {% endif %}
    </div>
    <aside class="rail">
      <p class="label" style="margin-top:28px">{{ t('issue.channel_promo') }}</p>
      {% if channelUrl %}<p style="margin-top:8px"><a href="{{ channelUrl }}" target="_blank" rel="noopener" data-goal="channel">{{ t('nav.channel') }} →</a></p>{% endif %}
    </aside>
  </div>

{% else %}
  {# ---------- material ---------- #}
  {% if issue.thought_ru %}<p class="thesis" data-label="{{ t('issue.thought') }}">{{ issue.thought_ru }}</p>{% endif %}

  {% if not (v.notes | length) and v.announceHtml %}<div class="prose" style="margin-top:28px;max-width:68ch">{{ v.announceHtml | safe }}</div>{% endif %}

  <div class="grid12">
    <div class="main-col speakers">
      {% for l in issue.lecturers %}
        <div class="speaker-box">
          {{ m.portrait(l) }}
          <span><span class="label">{{ t('issue.lecturer') }}</span><b>{{ l.name_ru }}</b><p>{{ l.role_ru }}{% if l.org_ru %}, {{ l.org_ru }}{% endif %}</p>{% if l.bio_ru %}<p class="bio">{{ l.bio_ru }}</p>{% endif %}</span>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if v.notes | length %}
  <section aria-label="{{ t('issue.notes') }}" id="notes">
    {% for n in v.notes %}
    <div class="idea">
      <div class="txt">
        <h3><span>{{ pad2(loop.index) }}</span>{{ n.h }}</h3>
        {{ n.html | safe }}
      </div>
      {% if n.quote %}<aside><blockquote class="pull">{{ n.quote }}{% if n.quote_by or issue.lecturer %}<cite>{{ n.quote_by or issue.lecturer.name_ru }}</cite>{% endif %}</blockquote></aside>{% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if v.glossary | length %}
  <section class="block glossary" style="margin-top:8px">
    <h2>{{ t('issue.terms') }}</h2>
    <dl style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px 28px">
      {% for g in v.glossary %}<div><dt>{{ g.term }}</dt><dd>{{ g.def }}</dd></div>{% endfor %}
    </dl>
  </section>
  {% endif %}

  {% if v.qa | length %}
  <section class="block">
    <h2>{{ t('issue.qa') }}</h2>
    <div class="qa">
      {% for x in v.qa %}
        <div class="qa-item"><i>В:</i><span class="q">{{ x.q }}</span><i>О:</i><div class="a">{{ x.a | safe }}</div></div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if v.video.cut or v.video.full %}
  <section class="block">
    <h2>{{ t('issue.video') }}</h2>
    <div class="videos">
      {% if v.video.cut %}{{ videoBlock(v.video.cut, (t('issue.video_cut', {len: v.video.cut.len}) if v.video.cut.len else t('issue.video_cut_plain')), cover, issue.lecturer) }}{% endif %}
      {% if v.video.full %}{{ videoBlock(v.video.full, t('issue.video_full') + (', ' + v.video.full.len if v.video.full.len else ''), cover, issue.lecturer) }}{% endif %}
    </div>
  </section>
  {% endif %}

  {% if issue.photos | length %}
  <section class="block">
    <h2>{{ t('issue.photos') }}</h2>
    <div class="gallery" data-gallery>
      {% for p in issue.photos %}
        <a href="/media/img/{{ p.base }}/{{ (p.widths | fromjson | last) }}.webp" class="{{ 'wide' if loop.first and issue.photos | length > 3 }}" data-lightbox data-caption="{{ p.alt }}{% if p.credit %} · {{ t('photo.by') }}: {{ p.credit }}{% endif %}">
          {{ picture(p, {sizes: '(max-width: 640px) 50vw, 340px', src: 480, alt: p.alt}) }}
        </a>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if issue.slides or issue.reads | length %}
  <section class="block">
    <h2>{{ t('issue.materials') }}</h2>
    <div class="materials">
      {% if issue.slides %}<a class="file-link" href="{{ fileUrl(issue.slides) }}" target="_blank" rel="noopener">{{ t('issue.slides') }} <small>{{ issue.slides.bytes | bytes }}</small></a>{% endif %}
      {% if issue.reads | length %}
      <div><p class="label" style="margin-bottom:8px">{{ t('issue.reads') }}</p>
        <ul class="reads">{% for r in issue.reads %}<li>{% if r.url %}<a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.title }}</a>{% else %}{{ r.title }}{% endif %}</li>{% endfor %}</ul>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if issue.autograph %}
  <section class="autograph" aria-label="{{ t('issue.autograph') }}">
    <span class="label">{{ t('issue.autograph') }}</span>
    {{ picture(issue.autograph, {sizes: '(max-width: 640px) 90vw, 640px', src: 960, alt: issue.autograph.alt or t('issue.autograph')}) }}
    {% if issue.lecturer %}<span class="mono muted" style="font-size:12.5px">— {{ issue.lecturer.name_ru }}</span>{% endif %}
  </section>
  {% endif %}

  <div class="check">
    {% if issue.note_author %}<span>{{ t('issue.noted_by', {name: issue.note_author}) }}</span>{% endif %}
    <span class="{{ 'ok' if issue.checked else 'no' }}">{% if issue.checked %}✓ {{ t('issue.checked') }}{% else %}{{ t('issue.unchecked') }}{% endif %}</span>
    {% if channelUrl %}<span>{{ t('issue.channel_promo') }} — <a href="{{ channelUrl }}" target="_blank" rel="noopener" data-goal="channel">{{ t('nav.channel') }}</a></span>{% endif %}
  </div>

  {% if issue.tags | length %}
  <p class="tags" style="margin-top:16px">{% for tg in issue.tags %}<a href="/vypuski?tag={{ tagKey(tg) | urlencode }}">#{{ tagName(tg) }}</a>{% endfor %}</p>
  {% endif %}

  {% set materialHtml = v.materialHtml %}{% include "partials/material.njk" %}

  <section class="block" id="review">
    <h2>{{ t('issue.review') }}</h2>
    {{ f.review(issue) }}
  </section>

  <div class="actions" style="margin-top:32px">
    <button class="btn" type="button" data-share>{{ t('btn.share') }}</button>
    <button class="btn" type="button" data-print>{{ t('btn.print') }}</button>
  </div>
{% endif %}

<nav class="neighbors" aria-label="{{ t('issue.prev') }} / {{ t('issue.next') }}">
  {% if v.prev %}<a href="/vypusk/{{ v.prev.slug }}" rel="prev"><span class="label">← {{ issueNo(v.prev.number) }}</span><b>{{ v.prev.title_ru }}</b></a>{% else %}<span></span>{% endif %}
  {% if v.next %}<a href="/vypusk/{{ v.next.slug }}" rel="next"><span class="label">{{ issueNo(v.next.number) }} →</span><b>{{ v.next.title_ru }}</b></a>{% endif %}
</nav>

{% if v.similar | length %}
<section class="block">
  <h2>{{ t('issue.similar') }}</h2>
  <div class="cards">{% for i in v.similar %}{{ m.issueCard(i) }}{% endfor %}</div>
</section>
{% endif %}
{% endblock %}
