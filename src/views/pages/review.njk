{% extends "layouts/base.njk" %}
{% import "partials/forms.njk" as f with context %}

{% block content %}
<div style="max-width:640px">
  <span class="label">{{ t('fb.review') }}</span>
  <div class="issue-no" aria-hidden="true" style="font-size:96px"><small>№</small>{{ pad2(issue.number) }}</div>
  <h1 style="font-size:28px;margin:10px 0 24px">{{ issue.title_ru }}</h1>
  {% if started %}{{ f.review(issue, true) }}{% else %}<p class="banner">{{ t('fb.review_closed') }}</p>{% endif %}
</div>
{% endblock %}
