# Science Lounge: настройки. Скопируйте в .env и заполните.

# Публичный адрес сайта. С https:// включаются Secure-cookie и HSTS.
SITE_URL=https://sciencelounge.example
# Домен для HTTPS в Docker (Caddy сам получает сертификат). Без Docker не нужен.
SITE_DOMAIN=
PORT=3000
HOST=127.0.0.1
# Сайт стоит за nginx/Caddy/Docker-прокси: берём настоящий IP из X-Forwarded-For.
TRUST_PROXY=true

# Где лежат база, фото и копии. В Docker это том /app/data.
DATA_DIR=data
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=30

# Первый администратор (создаётся при самом первом запуске, потом можно убрать).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Администратор

# Telegram-бот для уведомлений организаторам о новых обращениях.
# Токен даёт @BotFather; chat_id — личный чат или группа, куда добавлен бот.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Аналитика (необязательно). Метрика грузится только после согласия в баннере.
METRIKA_ID=
# Umami на своём сервере: без cookie, баннер не нужен.
UMAMI_SRC=
UMAMI_ID=

# Длительность лекции в календаре (минуты) и срок сессии админки (дни).
LECTURE_MINUTES=90
SESSION_DAYS=14

# Automatic science news from public RSS feeds (sources and the on/off switch are also in the admin settings)
NEWS_AUTO=true
