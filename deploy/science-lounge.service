# systemd unit для запуска без Docker. Поправьте пути и пользователя.
# sudo cp deploy/science-lounge.service /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now science-lounge
[Unit]
Description=Science Lounge
After=network.target

[Service]
Type=simple
User=sciencelounge
WorkingDirectory=/opt/science-lounge
EnvironmentFile=/opt/science-lounge/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/science-lounge/data

[Install]
WantedBy=multi-user.target
